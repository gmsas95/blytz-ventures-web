  {
    title: "Startup Incubation",
    tagline: "From idea to product",
    description: "We validate concepts, assemble lean teams, and ship MVPs fast — turning early-stage ideas into investable companies.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    gradient: "from-amber-400 to-yellow-300"
  },
  {
    title: "Product Strategy",
    tagline: "Build what matters",
    description: "Define roadmaps, prioritize features, and design product experiences that users actually need and pay for.",
    icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
    gradient: "from-yellow-400 to-amber-300"
  },
  {
    title: "MVP Development",
    tagline: "Ship in weeks, not months",
    description: "Full-stack engineering for web, mobile, and AI-powered products — using modern stacks that scale with your growth.",
    icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
    gradient: "from-amber-300 to-orange-300"
  },
  {
    title: "AI & Automation Consulting",
    tagline: "Work smarter",
    description: "Identify where AI, agents, and automation can reduce costs and unlock growth — then implement them responsibly.",
    icon: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
    gradient: "from-orange-300 to-amber-400"
  },
  {
    title: "Go-to-Market Advisory",
    tagline: "Find your first customers",
    description: "Positioning, pricing, sales playbooks, and growth experiments to help you land early adopters and repeat revenue.",
    icon: "M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z",
    gradient: "from-amber-400 to-orange-300"
  },
  {
    title: "Fractional CTO",
    tagline: "Technical leadership on demand",
    description: "Senior technical guidance for architecture decisions, team hiring, vendor selection, and scaling without burning runway.",
    icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
    gradient: "from-yellow-300 to-amber-400"
