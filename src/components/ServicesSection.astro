---

<section id="services" class="section-padding bg-black relative overflow-hidden">
  <!-- Subtle glow -->
  <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[600px] h-[600px] bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>
  
  <div class="container-max relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-14">
      <div class="lg:col-span-6">
        <div class="scroll-reveal inline-flex items-center gap-3 bg-white/5 border border-white/10 px-4 py-2 rounded-full mb-6">
          <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="text-xs font-semibold uppercase tracking-widest text-amber-400">What We Do</span>
        </div>
        <h2 class="scroll-reveal text-section text-white">
          STARTUP STUDIO<br />+ CONSULTANCY
        </h2>
      </div>
      
      <div class="lg:col-span-6 flex items-end">
        <p class="scroll-reveal text-subhero text-white/50 max-w-2xl">
          We build our own ventures and partner with founders, teams, and organizations to ship products, design strategy, and scale with speed.
        </p>
      </div>
    </div>
    
    <!-- Services grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {services.map((service, i) => (
        <div class="scroll-reveal-delay bento-card p-8 relative overflow-hidden group">
          <div class={`absolute inset-0 bg-gradient-to-br ${service.gradient} opacity-0 group-hover:opacity-5 transition-opacity duration-500`}></div>
          
          <span class={`text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-br ${service.gradient} opacity-10 absolute -top-3 -right-3`}>
            {String(i + 1).padStart(2, '0')}
          </span>
          
          <div class="relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-500 to-yellow-500 flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon} />
              </svg>
            </div>
            
            <h3 class="text-2xl font-extrabold text-white mb-1.5 tracking-tight group-hover:text-amber-400 transition-colors">
              {service.title}
            </h3>
            <p class={`text-base font-semibold mb-3 bg-gradient-to-r ${service.gradient} bg-clip-text text-transparent`}>
              {service.tagline}
            </p>
            <p class="text-white/50 text-sm leading-relaxed">
              {service.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
