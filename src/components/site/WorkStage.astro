---
import IconArrow from "./IconArrow.astro";
---

<section class="stage stage-raised stage-work" id="blytz-work" aria-labelledby="blytz-work-name">
  <div class="rail rail-wide stage-inner">
    <div class="stage-copy">
      <div class="product-head">
        <h2 class="product-name" id="blytz-work-name">blytz<span class="product-tld">.work</span></h2>
        <span class="chip chip-signal"><span class="dot"></span>Marketing department live</span>
      </div>
      <p class="stage-tagline">A hosted marketing department that keeps moving.</p>
      <p class="stage-body">
        Give its CMO a goal. It plans the mission, assigns specialist agents, and brings back
        reviewable work — publishing and spend wait for your approval.
      </p>
      <div class="stage-actions">
        <a class="btn btn-primary" href="https://blytz.work">Hire the marketing department <IconArrow size={11} /></a>
        <a class="btn btn-ghost" href="https://blytz.work">See how it works <IconArrow size={11} /></a>
      </div>
    </div>

    <div class="stage-stage">
      <figure class="vignette" aria-label="Illustrative blytz.work workboard">
        <div class="vignette-chrome">
          <span class="vignette-title">blytz://workboard</span>
          <span class="chip chip-signal"><span class="dot"></span>Approval inbox open</span>
        </div>
        <div class="vignette-body">
          <div class="v-mission">
            <div class="v-mission-head">
              <span class="label">Mission</span>
              <span class="label">3 tasks moving</span>
            </div>
            <p class="v-mission-title">Launch the next campaign</p>
            <div class="v-cmo">
              <span>Chief Marketing Officer — delegating specialist work</span>
              <span>On track</span>
            </div>
          </div>
          <div class="v-task">
            <span class="v-task-name">Paid-media review</span>
            <span class="v-task-agent">Paid Ads Agent</span>
            <span class="chip chip-quiet">Prepared · not published</span>
          </div>
          <div class="v-task">
            <span class="v-task-name">Threads content batch</span>
            <span class="v-task-agent">Threads Agent</span>
            <span class="chip chip-quiet">Prepared · not published</span>
          </div>
          <div class="v-task">
            <span class="v-task-name">Brand check</span>
            <span class="v-task-agent">Brand Review</span>
            <span class="chip chip-signal">Needs review</span>
          </div>
          <p class="v-note">Publishing and spend stay behind your approval.</p>
        </div>
        <figcaption>Illustrative interface · sample values</figcaption>
      </figure>
    </div>
  </div>
</section>
