---
interface Props {
  size?: number;
  class?: string;
}

const { size = 12, class: className } = Astro.props;
---

<svg
  class:list={["arrow", className]}
  width={size}
  height={size}
  viewBox="0 0 12 12"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
>
  <path d="M2.5 9.5 9.5 2.5M4.25 2.5h5.25v5.25" stroke-linecap="round" stroke-linejoin="round" />
</svg>
