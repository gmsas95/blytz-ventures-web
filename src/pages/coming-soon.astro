---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/react/Header';
import { Footer } from '../components/react/Footer';

const venture = Astro.url.searchParams.get("v");

const ventures: Record<string, { name: string; tagline: string; icon: string; url?: string }> = {
  cloud: { name: "blytz cloud", tagline: "AI Assistant Platform", icon: "🤖" },
  marketplace: { name: "blytz marketplace", tagline: "E-Commerce & Live Auctions", icon: "🛒", url: "https://marketplace.blytz.cloud/" },
  work: { name: "blytz work", tagline: "Fastest Job Matching", icon: "💼", url: "https://work.blytz.cloud/" },
  site: { name: "blytz site", tagline: "Website Builder Platform", icon: "🌐" },
};

const current = venture ? ventures[venture] : null;

// Redirect live ventures straight to their product URL.
if (current?.url) {
  return Astro.redirect(current.url);
}

const title = current ? `${current.name} — Coming Soon` : "Coming Soon";
---

<Layout title={`${title} - Blytz Ventures`}>
  <Header client:load />
  <main class="flex min-h-screen items-center justify-center bg-white pt-24">
    <div class="max-w-lg px-6 text-center">
      <div class="mb-8 text-7xl">{current?.icon || "🚧"}</div>
      <h1 class="mb-4 text-4xl font-extrabold tracking-tight text-gray-900 md:text-6xl">
        {current?.name || "Coming Soon"}
      </h1>
      <p class="mb-6 text-xl font-semibold text-amber-600 md:text-2xl">
        {current?.tagline || "Under Development"}
      </p>
      <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-4 py-2 text-sm font-semibold uppercase tracking-wider text-amber-700">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-500 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-amber-600"></span>
        </span>
        Under Development
      </div>
      <p class="mb-10 text-lg leading-relaxed text-gray-600">
        {current
          ? `${current.name} is currently being built. We're working hard to bring this venture to life.`
          : "This venture is currently under development. Stay tuned for updates."}
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/#ventures" class="inline-flex items-center gap-2 rounded-lg bg-amber-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-amber-700">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Ventures
        </a>
        <a href="/contact" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-6 py-3 font-semibold text-gray-900 transition-colors hover:border-gray-400 hover:bg-gray-50">
          Get in Touch
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </main>
  <Footer client:load />
</Layout>
