---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/react/Header';
import { Hero } from '../components/react/Hero';
import { Services } from '../components/react/Services';
import { Ventures } from '../components/react/Ventures';
import { CTA } from '../components/react/CTA';
import { Footer } from '../components/react/Footer';
---

<Layout title="Blytz Ventures - Startup Studio & Technology Consultancy">
  <Header client:load />
  <main>
    <Hero client:load />
    <Services client:load />
    <Ventures client:load />
    <CTA client:load />
  </main>
  <Footer client:load />
</Layout>
