---
import Layout from "../layouts/Layout.astro";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";

const description = "Notes from the Blytz Ventures studio on AI products, marketing operations, and building in Southeast Asia.";
---

<Layout title="Blog — Blytz Ventures" description={description}>
  <Header />
  <main id="main" class="page">
    <div class="rail page-inner">
      <h1>Blog</h1>
      <p class="page-lede">Notes from the studio on AI products, marketing operations, and building in Southeast Asia.</p>

      <div class="blog-empty">
        <span class="label">Status</span>
        <p>Nothing published yet — new writing will land here. The fastest way to see what we are building is to open a product.</p>
        <div class="stage-actions">
          <a class="btn btn-ghost" href="https://blytz.app">blytz.app</a>
          <a class="btn btn-ghost" href="https://blytz.work">blytz.work</a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
