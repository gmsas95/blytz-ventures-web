---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/react/Header';
import { Footer } from '../components/react/Footer';
---

<Layout title="Blog - Blytz Ventures">
  <Header client:load />
  <main class="bg-white pb-20 pt-24">
    <div class="container mx-auto max-w-4xl px-4 md:px-8">
      <div class="text-center">
        <p class="text-sm font-semibold text-amber-600">Blog</p>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 md:text-4xl">Insights & updates</h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">
          Thoughts from the Blytz Ventures team on startups, product, and technology.
        </p>
      </div>

      <div class="mt-20 rounded-2xl border border-gray-200 bg-gray-50/50 py-20 text-center">
        <div class="inline-flex items-center gap-3 text-gray-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          <span>Coming soon — stay tuned for updates</span>
        </div>
      </div>
    </div>
  </main>
  <Footer client:load />
</Layout>
